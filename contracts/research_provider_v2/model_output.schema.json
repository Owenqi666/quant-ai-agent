{
  "$defs": {
    "DraftCandidate": {
      "additionalProperties": false,
      "properties": {
        "changes": {
          "description": "Actual deviations only: [] for paper_original, nonempty for model_conjecture. Do not list faithful translation, preservation, no-change statements or implementation narration.",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Changes",
          "type": "array"
        },
        "expression": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "hypothesis_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "origin": {
          "description": "paper_original requires changes=[] for an unchanged paper formula. model_conjecture requires nonempty actual changes. Model-generated candidates cannot claim user_modification authority.",
          "enum": [
            "paper_original",
            "user_modification",
            "model_conjecture"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "id",
        "hypothesis_id",
        "expression",
        "origin",
        "changes"
      ],
      "title": "DraftCandidate",
      "type": "object"
    },
    "DraftEvidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "page": {
          "maximum": 500,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "id",
        "page",
        "quote"
      ],
      "title": "DraftEvidence",
      "type": "object"
    },
    "DraftHypothesis": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Assumptions",
          "type": "array"
        },
        "attribution": {
          "enum": [
            "paper_original",
            "user_modification",
            "model_conjecture"
          ],
          "title": "Attribution",
          "type": "string"
        },
        "claim": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "economic_mechanism": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Economic Mechanism",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "mechanism_attribution": {
          "enum": [
            "paper_original",
            "user_modification",
            "model_conjecture"
          ],
          "title": "Mechanism Attribution",
          "type": "string"
        },
        "required_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Required Fields",
          "type": "array"
        },
        "signal_direction": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Signal Direction",
          "type": "string"
        }
      },
      "required": [
        "id",
        "claim",
        "attribution",
        "evidence_ids",
        "economic_mechanism",
        "mechanism_attribution",
        "signal_direction",
        "required_fields",
        "assumptions"
      ],
      "title": "DraftHypothesis",
      "type": "object"
    },
    "MaterialData": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Evidence Ids",
          "type": "array"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "semantics": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Semantics",
          "type": "string"
        }
      },
      "required": [
        "name",
        "semantics",
        "evidence_ids"
      ],
      "title": "MaterialData",
      "type": "object"
    },
    "MaterialDraft": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/MaterialEvidence"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/MaterialHypothesis"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Hypotheses",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Limitations",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "unresolved_rules": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Unresolved Rules",
          "type": "array"
        }
      },
      "required": [
        "title",
        "evidence",
        "hypotheses",
        "unresolved_rules",
        "limitations"
      ],
      "title": "MaterialDraft",
      "type": "object"
    },
    "MaterialEvidence": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "normalized_end": {
          "maximum": 2000000,
          "minimum": 1,
          "title": "Normalized End",
          "type": "integer"
        },
        "normalized_start": {
          "maximum": 2000000,
          "minimum": 0,
          "title": "Normalized Start",
          "type": "integer"
        },
        "page": {
          "maximum": 500,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "printed_page": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Page"
        },
        "quote": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "id",
        "page",
        "chunk_id",
        "quote",
        "normalized_start",
        "normalized_end",
        "printed_page"
      ],
      "title": "MaterialEvidence",
      "type": "object"
    },
    "MaterialHypothesis": {
      "additionalProperties": false,
      "properties": {
        "calculation": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calculation"
        },
        "claim": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "claim_attribution": {
          "enum": [
            "paper_original",
            "model_conjecture",
            "unresolved"
          ],
          "title": "Claim Attribution",
          "type": "string"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Conditions",
          "type": "array"
        },
        "economic_mechanism": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Economic Mechanism"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "mechanism_attribution": {
          "enum": [
            "paper_original",
            "model_conjecture",
            "unresolved"
          ],
          "title": "Mechanism Attribution",
          "type": "string"
        },
        "required_data": {
          "items": {
            "$ref": "#/$defs/MaterialData"
          },
          "maxItems": 30,
          "title": "Required Data",
          "type": "array"
        },
        "signal_direction": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Signal Direction"
        },
        "unresolved_rules": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Unresolved Rules",
          "type": "array"
        }
      },
      "required": [
        "id",
        "claim",
        "claim_attribution",
        "evidence_ids",
        "economic_mechanism",
        "mechanism_attribution",
        "signal_direction",
        "required_data",
        "calculation",
        "conditions",
        "unresolved_rules"
      ],
      "title": "MaterialHypothesis",
      "type": "object"
    },
    "ProposalAbstention": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "description": "Only IDs already exposed in context.evidence, or context.research_context.evidence. Never invent IDs or use page/chunk IDs. For paper_selection with no exposed draft evidence use [].",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Ids",
          "type": "array"
        },
        "missing_requirements": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Missing Requirements",
          "type": "array"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "EVIDENCE_INSUFFICIENT",
            "FIELD_UNAVAILABLE",
            "RULES_UNCLEAR",
            "OPERATOR_UNSUPPORTED"
          ],
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "reason_code",
        "reason",
        "missing_requirements",
        "evidence_ids"
      ],
      "title": "ProposalAbstention",
      "type": "object"
    },
    "ResearchDecision": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "repair",
            "request_information",
            "propose_experiment",
            "stop"
          ],
          "title": "Action",
          "type": "string"
        },
        "candidate_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^\\S(?:[^\\r\\n]*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Id"
        },
        "information_gaps": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Information Gaps",
          "type": "array"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "target_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Digest"
        }
      },
      "required": [
        "action",
        "reason",
        "candidate_id",
        "target_digest",
        "information_gaps"
      ],
      "title": "ResearchDecision",
      "type": "object"
    },
    "ResearchDraft": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/DraftCandidate"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/DraftEvidence"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/DraftHypothesis"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Hypotheses",
          "type": "array"
        }
      },
      "required": [
        "evidence",
        "hypotheses",
        "candidates"
      ],
      "title": "ResearchDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "abstention": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProposalAbstention"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_id": {
      "pattern": "^proposal_attempt_[0-9a-f]{64}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "context_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Context Digest",
      "type": "string"
    },
    "contract_id": {
      "const": "research_provider_v2",
      "title": "Contract Id",
      "type": "string"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchDecision"
        },
        {
          "type": "null"
        }
      ]
    },
    "draft": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchDraft"
        },
        {
          "type": "null"
        }
      ]
    },
    "material": {
      "anyOf": [
        {
          "$ref": "#/$defs/MaterialDraft"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "enum": [
        "extract_material",
        "generate_candidates",
        "repair_candidate",
        "decide_next_action"
      ],
      "title": "Operation",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "material",
        "draft",
        "decision",
        "abstain"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "proposal_id": {
      "pattern": "^proposal_[0-9a-f]{64}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "contract_id",
    "operation",
    "proposal_id",
    "attempt_id",
    "context_digest",
    "outcome",
    "material",
    "draft",
    "decision",
    "abstention"
  ],
  "title": "ResearchProviderOutput",
  "type": "object"
}
