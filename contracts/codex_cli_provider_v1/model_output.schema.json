{
  "$defs": {
    "DraftCandidate": {
      "additionalProperties": false,
      "properties": {
        "changes": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Changes",
          "type": "array"
        },
        "expression": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "hypothesis_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "paper_original",
            "user_modification",
            "model_conjecture"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "id",
        "hypothesis_id",
        "expression",
        "origin",
        "changes"
      ],
      "title": "DraftCandidate",
      "type": "object"
    },
    "DraftEvidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "page": {
          "maximum": 500,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "id",
        "page",
        "quote"
      ],
      "title": "DraftEvidence",
      "type": "object"
    },
    "DraftHypothesis": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Assumptions",
          "type": "array"
        },
        "attribution": {
          "enum": [
            "paper_original",
            "user_modification",
            "model_conjecture"
          ],
          "title": "Attribution",
          "type": "string"
        },
        "claim": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "economic_mechanism": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Economic Mechanism",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "mechanism_attribution": {
          "enum": [
            "paper_original",
            "user_modification",
            "model_conjecture"
          ],
          "title": "Mechanism Attribution",
          "type": "string"
        },
        "required_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Required Fields",
          "type": "array"
        },
        "signal_direction": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Signal Direction",
          "type": "string"
        }
      },
      "required": [
        "id",
        "claim",
        "attribution",
        "evidence_ids",
        "economic_mechanism",
        "mechanism_attribution",
        "signal_direction",
        "required_fields",
        "assumptions"
      ],
      "title": "DraftHypothesis",
      "type": "object"
    },
    "ProposalAbstention": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Ids",
          "type": "array"
        },
        "missing_requirements": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Missing Requirements",
          "type": "array"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "EVIDENCE_INSUFFICIENT",
            "FIELD_UNAVAILABLE",
            "RULES_UNCLEAR",
            "OPERATOR_UNSUPPORTED"
          ],
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "reason_code",
        "reason",
        "missing_requirements",
        "evidence_ids"
      ],
      "title": "ProposalAbstention",
      "type": "object"
    },
    "ResearchDraft": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/DraftCandidate"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/DraftEvidence"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/DraftHypothesis"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Hypotheses",
          "type": "array"
        }
      },
      "required": [
        "evidence",
        "hypotheses",
        "candidates"
      ],
      "title": "ResearchDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "abstention": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProposalAbstention"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_id": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "context_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Context Digest",
      "type": "string"
    },
    "draft": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchDraft"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "enum": [
        "draft",
        "abstain"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "proposal_id": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "proposal_id",
    "attempt_id",
    "context_digest",
    "outcome",
    "draft",
    "abstention"
  ],
  "title": "ProposalModelOutput",
  "type": "object"
}
