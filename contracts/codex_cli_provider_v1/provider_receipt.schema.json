{
  "$defs": {
    "ProviderUsage": {
      "additionalProperties": false,
      "properties": {
        "cached_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Input Tokens"
        },
        "complete": {
          "default": false,
          "title": "Complete",
          "type": "boolean"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "model_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Calls"
        },
        "observed_turns": {
          "default": 0,
          "minimum": 0,
          "title": "Observed Turns",
          "type": "integer"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "raw": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Raw",
          "type": "array"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        },
        "tool_events": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Events",
          "type": "integer"
        }
      },
      "title": "ProviderUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "cli_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cli Version"
    },
    "elapsed_seconds": {
      "minimum": 0,
      "title": "Elapsed Seconds",
      "type": "number"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "finished_at": {
      "title": "Finished At",
      "type": "string"
    },
    "fixture": {
      "default": false,
      "title": "Fixture",
      "type": "boolean"
    },
    "invocation_started": {
      "default": false,
      "title": "Invocation Started",
      "type": "boolean"
    },
    "process_stopped": {
      "default": true,
      "title": "Process Stopped",
      "type": "boolean"
    },
    "proposal_id": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "reported_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reported Model"
    },
    "requested_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Model"
    },
    "response_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Sha256"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "stderr_bytes": {
      "default": 0,
      "minimum": 0,
      "title": "Stderr Bytes",
      "type": "integer"
    },
    "stdout_bytes": {
      "default": 0,
      "minimum": 0,
      "title": "Stdout Bytes",
      "type": "integer"
    },
    "usage": {
      "$ref": "#/$defs/ProviderUsage"
    }
  },
  "required": [
    "proposal_id",
    "attempt_id",
    "started_at",
    "finished_at",
    "elapsed_seconds"
  ],
  "title": "ProviderReceipt",
  "type": "object"
}
