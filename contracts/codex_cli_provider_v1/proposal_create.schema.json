{
  "$defs": {
    "ProposalBudget": {
      "additionalProperties": false,
      "properties": {
        "hard_cost_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hard Cost Limit"
        },
        "hard_model_call_limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hard Model Call Limit"
        },
        "hard_token_limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hard Token Limit"
        },
        "max_context_bytes": {
          "default": 131072,
          "maximum": 131072,
          "minimum": 1024,
          "title": "Max Context Bytes",
          "type": "integer"
        },
        "max_log_bytes": {
          "default": 8388608,
          "maximum": 8388608,
          "minimum": 1024,
          "title": "Max Log Bytes",
          "type": "integer"
        },
        "max_output_bytes": {
          "default": 65536,
          "maximum": 65536,
          "minimum": 1024,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "max_provider_invocations": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Provider Invocations",
          "type": "integer"
        },
        "max_seconds": {
          "default": 60,
          "maximum": 600,
          "minimum": 1,
          "title": "Max Seconds",
          "type": "integer"
        },
        "output_token_target": {
          "default": 2000,
          "maximum": 2000,
          "minimum": 1,
          "title": "Output Token Target",
          "type": "integer"
        },
        "token_scheduling_threshold": {
          "default": 12000,
          "maximum": 12000,
          "minimum": 1,
          "title": "Token Scheduling Threshold",
          "type": "integer"
        }
      },
      "title": "ProposalBudget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_revision_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Base Revision Id",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/ProposalBudget"
    },
    "candidate_limit": {
      "default": 3,
      "maximum": 3,
      "minimum": 1,
      "title": "Candidate Limit",
      "type": "integer"
    },
    "expected_source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Expected Source Digest",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "instruction": {
      "default": "",
      "maxLength": 4000,
      "title": "Instruction",
      "type": "string"
    },
    "provider_config_id": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "title": "Provider Config Id",
      "type": "string"
    },
    "purpose": {
      "default": "generate_from_evidence",
      "enum": [
        "generate_from_evidence",
        "repair_candidate"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "research_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Research Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "research_id",
    "base_revision_id",
    "expected_source_digest",
    "provider_config_id",
    "idempotency_key"
  ],
  "title": "ProposalCreate",
  "type": "object"
}
